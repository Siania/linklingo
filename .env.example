# Vercel / Railway / etc.: add the same names under Project → Environment Variables.
# .env is not deployed from git; only set secrets in the host’s dashboard.

# OpenAI (preferred if set) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional fallbacks
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast-non-reasoning

# PORT=3000

# Optional: persist request excerpts + IP for admin review (off by default for privacy).
# ENABLE_REQUEST_LOG=true

# Admin: view logged requests when ENABLE_REQUEST_LOG=true. Set a long random secret.
# Open /admin.html, paste the same value to load the list. Requires writable disk (not Vercel serverless).
# ADMIN_SECRET=
